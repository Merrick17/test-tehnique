{
  "name": "test_technique_router",
  "version": "1.0.0",
  "private": true,
  "description": "Lead distribution monorepo",
  "workspaces": [
    "api",
    "web"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm run dev:api\" \"npm run dev:web\"",
    "dev:api": "npm run dev -w api",
    "dev:web": "npm run dev -w web",
    "build": "npm run build --workspaces --if-present",
    "build:api": "npm run build -w api",
    "build:web": "npm run build -w web",
    "start:api": "npm run start -w api",
    "start:web": "npm run start -w web",
    "lint": "npm run lint --workspaces --if-present"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "concurrently": "^10.0.3"
  }
}
